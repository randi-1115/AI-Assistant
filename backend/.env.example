# 复制为 .env 用于本地开发。绝不要提交真实的 .env。
APP_ENV=development
APP_NAME=ai-assistant
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# 仅示例：请改成你自己本地 MySQL 的账号、密码和库名。
# 驱动用 aiomysql（纯 Python，Windows 免编译）。
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/ai_assistant?charset=utf8mb4
# 集成测试用的独立库。留空则 pytest tests/integration 会整体跳过，
# 不会误连到开发库上把数据清空。
TEST_DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/ai_assistant_test?charset=utf8mb4

# LLM 供应商：mock | deepseek
#   mock     —— 离线可用、不联网、不消耗 token，用于开发 UI 和跑单元测试
#   deepseek —— 真实调用。切过去之前必须填好 LLM_API_KEY 和 LLM_MODEL，
#               否则应用会在启动时直接报错（快速失败，避免第一次聊天才炸）
# LLM_MODEL 不要凭记忆写死：先请求 GET {LLM_BASE_URL}/models 确认可用模型名。
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.7

# 上下文窗口：只发送最近若干条消息，并按字符预算裁剪，不无限传送历史对话。
# 字符预算是 token 的近似值（中文约 1 字 ≈ 1 token）。
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_CHARS=8000

# CORS 允许来源，逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 第一阶段固定单用户，不做登录；所有查询仍按 user_id 过滤。
DEV_USER_EMAIL=dev@local
DEV_USER_DISPLAY_NAME=本地开发用户

# mock provider 行为，仅 LLM_PROVIDER=mock 时生效。
MOCK_STREAM_DELAY_MS=60
MOCK_CHUNK_SIZE=4
# 全局强制触发错误，用于手工验收错误分支：留空 | upstream | timeout | rate_limit | auth
MOCK_FORCE_ERROR=

# 联网搜索尚未选定服务商，保留键名。
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# 本地私有文件存储（P1 使用）。
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=20
RAG_TOP_K=4
AGENT_MAX_TOOL_CALLS=3
