# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=ai-assistant
API_V1_PREFIX=/api/v1

# Example only: change credentials/database name for your local MySQL installation.
DATABASE_URL=mysql+asyncmy://ai_app:CHANGE_ME@127.0.0.1:3306/ai_assistant?charset=utf8mb4

# LLM provider is intentionally unselected until a service is chosen.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.7

# Web search is intentionally unselected.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Local private file storage.
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=20
RAG_TOP_K=4
AGENT_MAX_TOOL_CALLS=3
