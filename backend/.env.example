# 复制为 .env 用于本地开发。绝不要提交真实的 .env。
APP_ENV=development
APP_NAME=ai-assistant
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# 仅示例：请改成你自己本地 MySQL 的账号、密码和库名。
# 驱动用 aiomysql（纯 Python，Windows 免编译）。
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/ai_assistant?charset=utf8mb4
# 集成测试用的独立库。留空则 pytest tests/integration 会整体跳过，
# 不会误连到开发库上把数据清空。
TEST_DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@127.0.0.1:3306/ai_assistant_test?charset=utf8mb4

# LLM 供应商：mock | deepseek
#   mock     —— 离线可用、不联网、不消耗 token，用于开发 UI 和跑单元测试
#   deepseek —— 真实调用。切过去之前必须填好 LLM_API_KEY 和 LLM_MODEL，
#               否则应用会在启动时直接报错（快速失败，避免第一次聊天才炸）
# LLM_MODEL 不要凭记忆写死：先请求 GET {LLM_BASE_URL}/models 确认可用模型名。
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.7

# 上下文窗口：只发送最近若干条消息，并按字符预算裁剪，不无限传送历史对话。
# 字符预算是 token 的近似值（中文约 1 字 ≈ 1 token）。
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_CHARS=8000

# CORS 允许来源，逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 第一阶段固定单用户，不做登录；所有查询仍按 user_id 过滤。
DEV_USER_EMAIL=dev@local
DEV_USER_DISPLAY_NAME=本地开发用户

# mock provider 行为，仅 LLM_PROVIDER=mock 时生效。
MOCK_STREAM_DELAY_MS=60
MOCK_CHUNK_SIZE=4
# 全局强制触发错误，用于手工验收错误分支：留空 | upstream | timeout | rate_limit | auth
MOCK_FORCE_ERROR=

# 联网搜索：none | tavily | serpapi。Tavily 为主源，SerpApi 可作为备源。
# 未配置或调用失败时聊天会降级并明确提示，不会伪造来源。
# 填好 TAVILY_API_KEY 后把 SEARCH_PROVIDER 改为 tavily；
# 想启用备源再填 SERPAPI_API_KEY 并设置 SEARCH_FALLBACK_PROVIDER=serpapi。
SEARCH_PROVIDER=none
SEARCH_FALLBACK_PROVIDER=
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_TIMEOUT_SECONDS=8
SEARCH_MAX_RESULTS=5
SEARCH_SNIPPET_CHARS=300
SEARCH_CONTEXT_MAX_CHARS=3000
# P1.5 质量硬化：查询规划、过取、排序、正文与缓存。
SEARCH_QUERY_PLAN_ENABLED=true
SEARCH_LLM_PLANNING_ENABLED=true
SEARCH_PLANNER_TIMEOUT_SECONDS=5
SEARCH_PLANNER_MAX_TOKENS=256
SEARCH_SUBQUERIES_ENABLED=true
SEARCH_MAX_SUBQUERIES=2
SEARCH_FETCH_RESULTS=10
SEARCH_PER_DOMAIN_MAX_RESULTS=2
SEARCH_TOTAL_TIMEOUT_SECONDS=12
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=128
SEARCH_EXTRA_AUTHORITY_DOMAINS=
SEARCH_INCLUDE_RAW_CONTENT=true
SEARCH_CONTENT_CHARS=1200

# 本地私有文件存储（P1 使用）。
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=20
RAG_TOP_K=4
AGENT_MAX_TOOL_CALLS=3

# 文档解析与切块。片段长度、重叠、单文件上限都可调。
RAG_CHUNK_SIZE_CHARS=800
RAG_CHUNK_OVERLAP_CHARS=100
RAG_MAX_CHUNKS_PER_FILE=500
RAG_MAX_EXTRACTED_CHARS=1000000
RAG_MAX_CANDIDATE_CHUNKS=2000
RAG_CANDIDATES_PER_FILE=400
RAG_CONTEXT_MAX_CHARS=4000
RAG_SOURCE_SNIPPET_CHARS=300
RAG_MAX_EXCERPTS_PER_FILE=2
RAG_CITATION_VALIDATION=true
RAG_SYNONYM_EXPANSION=false
